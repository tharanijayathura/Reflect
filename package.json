{
  "name": "reflect-fashion-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Reflect Fashion — Modern PERN Stack (PostgreSQL, Express, React/Next.js, Node.js) E-commerce Application",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:all": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "start": "npm run start --workspace=client",
    "start:client": "npm run start --workspace=client",
    "start:server": "npm run start --workspace=server",
    "lint": "npm run lint --workspace=client",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server"
  },
  "keywords": [
    "pern-stack",
    "nextjs",
    "react",
    "express",
    "postgresql",
    "ecommerce",
    "fashion",
    "typescript"
  ],
  "author": "Reflect Fashion Team",
  "license": "ISC"
}
